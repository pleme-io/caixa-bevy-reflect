   :body "//! Argument types and utilities for working with [`DynamicFunction`] and [`DynamicFunctionMut`].\n//!\n//! [`DynamicFunction`]: crate::func::DynamicFunction\n//! [`DynamicFunctionMut`]: crate::func::DynamicFunctionMut\n\npub use arg::*;\npub use count::*;\npub use error::*;\npub use from_arg::*;\npub use info::*;\npub use list::*;\npub use ownership::*;\n\nmod arg;\nmod count;\nmod error;\nmod from_arg;\nmod info;\nmod list;\nmod ownership;\n"} {:path "src/func/args/from_arg.rs"
