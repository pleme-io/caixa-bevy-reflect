   :body "//@check-pass\nuse bevy_reflect::{reflect_remote, Reflect};\n\nmod external_crate {\n    pub struct TheirFoo {\n        pub value: u32,\n    }\n}\n\n#[reflect_remote(external_crate::TheirFoo)]\nstruct MyFoo {\n    pub value: u32,\n}\n\n#[derive(Reflect)]\nstruct MyStruct {\n    #[reflect(remote = MyFoo)]\n    foo: external_crate::TheirFoo,\n}\n\nfn main() {}\n"} {:path "compile_fail/tests/reflect_remote/invalid_definition_pass.rs"
